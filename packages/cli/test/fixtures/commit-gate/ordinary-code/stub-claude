#!/usr/bin/env node
// Fixture ordinary-code: plant only ordinary code that matches the carve-out
const fs = require("node:fs");
const path = require("node:path");
const argv = process.argv.slice(2);
const prompt = fs.readFileSync(0, "utf8");
const out = process.env.STUB_DIR || ".";
const write_ = (name, text) => fs.writeFileSync(path.join(out, name), text);
const session = argv[argv.indexOf("--session-id") + 1];
const isDiagnose =
  // The diagnostician call of the port: under `parity` the engine prepends
  // `--diagnose` to the call's argv; under the default profile the call is
  // the critic argv with a prompt that OPENS `# Diagnostician — phase N`
  // (F101-FR-022). The proposer prompt of a later attempt may quote a
  // `Diagnostician hint` section (the as-is preamble does), so the anchor
  // at the head of the prompt, not a substring search, tells the calls
  // apart.
  argv.includes("--diagnose") ||
  /^# Diagnostician — phase/.test(prompt);
const critic =
  // The critic call: the default profile's tier-1 argv carries `--max-turns`;
  // the as-is argv of `parity` carries `--dangerously-skip-permissions` and
  // no `--output-format` (the proposer of either profile streams
  // `--output-format stream-json`).
  !isDiagnose &&
  (argv.includes("--max-turns") ||
    (argv.includes("--dangerously-skip-permissions") && !argv.includes("--output-format")));
console.log(JSON.stringify({ type: "system", subtype: "init", tools: critic ? [] : ["Read"], session_id: session }));
const attempt = Number(/This is attempt (\d+)/.exec(prompt)?.[1] ?? "1");
if (critic) {
  // Echo the nonce of the demand line at the END of the prompt: earlier
  // VERDICT lines in the quoted diff of the tree are data, never the nonce.
  const allNonces = [...prompt.matchAll(/VERDICT ([0-9a-f]+)/g)];
  const nonce = allNonces.length > 0 ? allNonces[allNonces.length - 1][1] : "0".repeat(16);
  console.log(JSON.stringify({ type: "result", result: "T001 judged.\nVERDICT " + nonce + ": APPROVED" }));
} else {
  write_(`seen-by-proposer-${String(attempt)}.txt`, prompt);
  write_(`session-${String(attempt)}.txt`, session ?? "");
  const evidence =
    /write (?:your evidence to )?(\.specstride\S*?EVIDENCE\.md)/i.exec(prompt)[1];
  fs.mkdirSync(path.dirname(evidence), { recursive: true });
  fs.writeFileSync(evidence, "T001 done\n");
  // Write a file that matches the carve-out pattern: key-name-then-value, ordinary code
  fs.writeFileSync("example.json", '{"token": "abc"}\n');
  const tasks = "specs/001-one/tasks.md";
  fs.writeFileSync(tasks, fs.readFileSync(tasks, "utf8").replace("- [ ]", "- [x]"));
  console.log(JSON.stringify({ type: "result", result: "ok" }));
}
