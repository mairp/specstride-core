{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specstride.commit-gate-rules/1",
  "title": "Rule data of the commit gate (F152-FR-016 to F152-FR-019)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "specstride.commit-gate-rules/1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "owner",
          "requirement",
          "reason",
          "effect",
          "match"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,48}$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "requirement": {
            "type": "string",
            "pattern": "^F[0-9]{3}-FR-[0-9]{3}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "effect": {
            "enum": [
              "block",
              "exempt"
            ]
          },
          "match": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pattern"
                ],
                "properties": {
                  "pattern": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "registeredSecret"
                ],
                "properties": {
                  "registeredSecret": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unreadable"
                ],
                "properties": {
                  "unreadable": {
                    "const": true
                  }
                },
                "$comment": "a hit with matched 'unreadable': a file of the commit the scan could not read (F111-FR-024, fail closed); an engine rule only"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unmatched"
                ],
                "properties": {
                  "unmatched": {
                    "const": true
                  }
                },
                "$comment": "the fallback: a hit that no other rule matches (a version skew between the pattern set and the rule data); an engine rule only"
              }
            ]
          }
        }
      }
    }
  },
  "$comment": "Loader rules beyond the schema: rule ids are unique across the engine and project files; engine ids start with 'cg-'; a project file may hold only effect 'block' (an 'exempt' rule, an id starting 'cg-', or a pattern that is not a name of the 'values' list of widened-v1.json, or a match 'unreadable' or 'unmatched' refuses the launch with exit 3); a reason the redactor changes is refused."
}
