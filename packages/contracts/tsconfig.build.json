{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".build/dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "noEmitOnError": true
  }
}
