{
  "stages": [
    {
      "id": "implement-feature",
      "kind": "specstride",
      "depends_on": [],
      "cwd": ".",
      "action": {
        "argv": [
          "specstride",
          "run",
          "-w",
          ".",
          "-s",
          "specs/001-greeting/tasks.md",
          "--spec-format",
          "speckit-tasks",
          "--feature",
          "001-greeting"
        ],
        "timeout_seconds": 3600
      },
      "preconditions": [
        {
          "type": "file_exists",
          "path": "approvals/release-approval.json",
          "timing": "preflight"
        },
        {
          "type": "command_available",
          "name": "specstride",
          "timing": "preflight"
        }
      ],
      "postconditions": [
        {
          "type": "dir_exists",
          "path": ".specstride/features/001-greeting"
        }
      ],
      "evidence": [
        ".specstride/features/001-greeting"
      ],
      "recovery": {
        "max_attempts": 1,
        "retry_exit_codes": [
          4
        ],
        "reason": {
          "jsonl": ".specstride/features/001-greeting/events.jsonl",
          "event": "run_stop",
          "field": "reason",
          "allowed": [
            "wall_budget"
          ]
        }
      }
    },
    {
      "id": "verify-greeting",
      "kind": "command",
      "depends_on": [],
      "cwd": ".",
      "action": {
        "argv": [
          "python3",
          "-c",
          "import pathlib; pathlib.Path('verified.txt').write_text('ok\\n')"
        ],
        "timeout_seconds": 600
      },
      "preconditions": [],
      "postconditions": [
        {
          "type": "file_exists",
          "path": "verified.txt"
        }
      ],
      "evidence": [
        "verified.txt"
      ]
    }
  ]
}
