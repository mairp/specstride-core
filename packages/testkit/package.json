{
  "name": "@specstride/testkit",
  "version": "0.0.0",
  "description": "Specstride test kit: the conformance frame, the sample implementations, the static tests, the table-level tests and the canary harness",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static/index.ts",
    "./static/amendments": "./src/static/amendments.ts",
    "./release/conditions": "./src/release/conditions.ts",
    "./release/attestation": "./src/release/attestation.ts",
    "./conformance": "./src/conformance/run.ts",
    "./conformance/frame": "./src/conformance/frame.ts",
    "./conformance/degrade": "./src/conformance/degrade.ts",
    "./conformance/EP-01": "./src/conformance/EP-01/contract.test.ts",
    "./conformance/EP-01/targets": "./src/conformance/EP-01/targets.ts",
    "./conformance/EP-01/host-suite": "./src/conformance/EP-01/host-suite.ts",
    "./conformance/EP-02": "./src/conformance/EP-02/contract.test.ts",
    "./conformance/EP-03": "./src/conformance/EP-03/contract.test.ts",
    "./conformance/EP-04": "./src/conformance/EP-04/contract.test.ts",
    "./conformance/EP-05": "./src/conformance/EP-05/contract.test.ts",
    "./conformance/EP-06": "./src/conformance/EP-06/contract.test.ts",
    "./conformance/EP-07": "./src/conformance/EP-07/contract.test.ts",
    "./conformance/EP-08": "./src/conformance/EP-08/contract.test.ts",
    "./conformance/EP-09": "./src/conformance/EP-09/contract.test.ts",
    "./conformance/EP-10": "./src/conformance/EP-10/contract.test.ts",
    "./conformance/EP-11": "./src/conformance/EP-11/contract.test.ts",
    "./conformance/EP-12": "./src/conformance/EP-12/contract.test.ts",
    "./conformance/EP-13": "./src/conformance/EP-13/contract.test.ts",
    "./conformance/EP-14": "./src/conformance/EP-14/contract.test.ts",
    "./conformance/EP-14/owner-rows": "./src/conformance/EP-14/owner-rows.ts",
    "./conformance/EP-14/owner-claims": "./src/conformance/EP-14/owner-claims.ts",
    "./conformance/EP-15": "./src/conformance/EP-15/contract.test.ts",
    "./conformance/EP-16": "./src/conformance/EP-16/contract.test.ts",
    "./conformance/EP-17": "./src/conformance/EP-17/contract.test.ts",
    "./conformance/EP-18": "./src/conformance/EP-18/contract.test.ts",
    "./conformance/EP-18/seams": "./src/conformance/EP-18/seams.ts",
    "./conformance/EP-19": "./src/conformance/EP-19/contract.test.ts",
    "./samples/EP-01": "./src/samples/EP-01/index.ts",
    "./samples/EP-18/critic-strategy": "./src/samples/EP-18/sample-critic-strategy.ts",
    "./samples/EP-18/attempt-planner": "./src/samples/EP-18/sample-attempt-planner.ts",
    "./canary": "./src/canary/scan.ts",
    "./canary/plant": "./src/canary/plant.ts",
    "./canary/stub-redactor": "./src/canary/stub-redactor.ts",
    "./conformance/EP-12/behaviour-127": "./src/conformance/EP-12/behaviour-127.ts",
    "./samples/EP-12/sample-127": "./src/samples/EP-12/sample-127.ts",
    "./samples/118/fake-clock": "./src/samples/118/fake-clock.ts",
    "./samples/118/fake-process-list": "./src/samples/118/fake-process-list.ts",
    "./samples/129": "./src/samples/129/index.ts",
    "./samples/129/fake-clock": "./src/samples/129/fake-clock.ts",
