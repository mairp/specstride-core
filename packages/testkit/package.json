    "./samples/129/second-read-model": "./src/samples/129/second-read-model.ts",
    "./conformance/view": "./src/conformance/view/suite.ts"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "node ../../tests/isolate.ts node --test \"test/**/*.test.*\" \"src/conformance/**/*.test.*\" \"src/samples/EP-02/**/*.test.*\"",
    "test:static": "node ../../tests/isolate.ts node --test src/static/index.ts",
    "test:tables": "node ../../tests/isolate.ts node --test \"src/tables/**/*.test.*\"",
    "test:canary": "node ../../tests/isolate.ts node --test \"test/canary.test.ts\" \"test/canary/**/*.test.*\"",
    "conformance": "node src/conformance/run.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@specstride/contracts": "0.0.0",
    "@specstride/import-boundary": "0.0.0",
    "@specstride/integrity": "0.0.0",
    "@specstride/kernel": "0.0.0",
    "@specstride/policy": "0.0.0",
    "@specstride/view": "0.0.0"
  }
