{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specstride:schema:internal:130:plugin-install/1",
  "type": "object",
  "required": ["contract", "status", "profile", "plugins", "reason", "requested_at", "completed_at", "request_archive"],
  "properties": {
    "contract": { "const": "specstride-dsh-plugin-install/v1" },
    "status": { "const": "installed" },
    "profile": { "type": "string" },
    "plugins": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" },
    "requested_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "request_archive": { "type": "string", "description": "logical name of the archived request" }
  }
}
