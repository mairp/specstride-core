{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specstride.report-rows/1",
  "title": "specstride report rows (F153-FR-039 to -041; data-model.md D6)",
  "description": "The rows of the read-only report in its opt-in --json form. A pure projection of events: unclosed attempts are shown as unclosed, unknowns are null, rows the events cannot hold are marked not-in-events (a closed set of one value). No free-text leaks (F153-FR-003). PROPOSAL of spec 153.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "rows"],
  "properties": {
    "schema": { "const": "specstride.report-rows/1" },
    "runId": { "type": ["string", "null"] },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "value"],
        "properties": {
          "row": { "type": "string" },
          "unit": { "type": "string" },
          "value": {
            "oneOf": [
              { "type": "number" },
              { "type": "null" },
              { "type": "string", "enum": ["not-in-events"] },
              {
                "type": "object",
                "additionalProperties": { "type": "number" },
                "propertyNames": { "type": "string" }
              }
            ]
          }
        }
      }
    }
  }
}
