{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:specstride:schema:specstride.inspect.tail/1",
 "title": "The `--json` record of `tail` (F119-FR-033; annex B §B.20)",
 "type": "object",
 "required": [
  "schema",
  "cmd",
  "ok"
 ],
 "properties": {
  "schema": {
   "const": "specstride.inspect.tail/1"
  },
  "cmd": {
   "const": "tail"
  },
  "ok": {
   "type": "boolean"
  },
  "feature": {
   "type": "string",
   "description": "The feature slug."
  },
  "reason": {
   "type": "string",
   "description": "A member of the closed set of F119-FR-030; required when ok is false."
  },
  "fix": {
   "type": "string",
   "description": "The fixed fix text of the reason; required when ok is false."
  },
  "name": {
   "type": "string",
   "description": "The logical name of the engine log; required when ok is true."
  },
  "bytes": {
   "type": "integer",
   "description": "Required when ok is true."
  },
  "lines": {
   "type": "integer",
   "description": "Required when ok is true."
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok"
    ]
   },
   "then": {
    "required": [
     "reason",
     "fix"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "ok"
    ]
   },
   "then": {
    "required": [
     "name",
     "bytes",
     "lines"
    ]
   }
  }
 ]
}
