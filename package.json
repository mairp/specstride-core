{
  "name": "specstride-core",
  "version": "0.1.0",
  "private": true,
  "description": "The Specstride engine: loop engineering and governance for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "node scripts/ci-test.mjs",
    "typecheck:src": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:imports": "node tools/import-boundary/src/index.ts",
    "test:e2e": "node scripts/plugin-e2e.ts",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
